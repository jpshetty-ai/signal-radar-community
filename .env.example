# Phase 2: Microsoft 365 mailbox via Graph (ADR-0007). Not secrets, kept out of Git anyway.
# Sign in once with: signal-radar auth work   (token cache goes to the macOS keychain)
M365_TENANT_ID=
M365_CLIENT_ID=
M365_USER=

# Gmail via IMAP (ADR-0008). Password: app password in the keychain, see README.
IMAP_GMAIL_USER=
