# Copy to .env (git-ignored). Set only what your choices in config/models.yaml use.
# The default (local Ollama) needs none of the keys below.

# Models: one key per cloud provider you pick in config/models.yaml
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_HOST=http://localhost:11434

# Optional: Microsoft 365 mailbox via Graph (ADR-0007). Not secrets, kept out of Git anyway.
# Sign in once with: signal-radar auth work   (token cache goes to the macOS keychain)
M365_TENANT_ID=
M365_CLIENT_ID=
M365_USER=

# Optional: Gmail via IMAP (ADR-0008). Password: app password in the keychain, see README.
IMAP_GMAIL_USER=

# Optional: Neo4j for the knowledge graph (config/graph.yaml, connector: neo4j). Or the macOS keychain.
SIGNAL_RADAR_NEO4J_PASSWORD=

# Optional: Jev judge for model evaluation (signal-radar models eval --judge jev)
TYPESAFE_API_KEY=
